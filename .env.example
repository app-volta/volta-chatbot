# Copie para .env local e substitua os placeholders. Nunca faça commit do .env.
APP_NAME=VOLTA API
ENVIRONMENT=qa
API_PREFIX=/v1
CORS_ORIGINS=["http://localhost:3000"]

# Gemini é obrigatório para embeddings/RAG; Groq pode ficar vazio se não usado.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=replace-me
GROQ_ROUTER_MODEL=openai/gpt-oss-120b

# Configure valores locais ou use os secrets correspondentes no cluster.
POSTGRES_DSN=postgresql://volta:volta@localhost:5432/volta
MONGO_URI=mongodb://localhost:27017/volta_memory?replicaSet=rs0
RAG_BASE_PATH=./data/faiss
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=volta
SOURCE_DOWNLOAD_TIMEOUT_SECONDS=20
ALLOWED_SOURCE_HOSTS=["sdgs.un.org","www.gov.br","jbsesg.com","ambientaljbs.com.br"]

COOPERATIVE_A2A_BASE_URL=
COOPERATIVE_A2A_HMAC_SECRET=
A2A_TIMEOUT_SECONDS=10
INGESTION_API_KEY=
JWT_KEY=replace-with-the-same-key-used-by-volta-api
OBSERVABILITY_API_KEY=

VOLTA_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=volta-chatbot-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
GROQ_INPUT_USD_PER_MILLION=0.59
GROQ_OUTPUT_USD_PER_MILLION=0.79
VALUE_PER_RESOLVED_CASE_BRL=35.0
